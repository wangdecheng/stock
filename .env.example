# Project-level environment overrides. bin/start.sh and bin/start-dev.sh
# `source` this file before activating the venv, so values propagate to
# every subprocess (Streamlit, scheduler daemon, runner subprocess).
#
# Usage:  cp .env.example .env  &&  $EDITOR .env
#
# Syntax: shell `export VAR=value`. Lines starting with `#` are comments.
# This file is gitignored; .env.example is the checked-in template.

# --- AKShare ---------------------------------------------------------------

# Set to 1 to bypass the system proxy (needed when ClashX/Surge is down
# and AKShare throws ProxyError). Patches requests.Session.__init__
# to trust_env=False. Leave unset to use the system proxy normally.
# export AKSHARE_DIRECT=1

